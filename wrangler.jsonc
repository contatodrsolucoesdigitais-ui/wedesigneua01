{
  "name": "portifoliowebdesign",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",

  // Os arquivos estaticos sao servidos primeiro. O Worker so roda
  // para caminhos que nao batem com um arquivo — ou seja, /api/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // O binding do D1 NAO fica aqui, de proposito.
  //
  // O banco precisa existir na MESMA conta em que o Worker publica
  // (f5d7ba04ca3a512a09b572b4c17c7d17). Declarar um database_id de
  // outra conta quebra o deploy — foi o que derrubou o build #55719216.
  //
  // Crie o banco pelo painel dessa conta e faca o binding em
  // Settings > Bindings, com o nome de variavel exatamente "DB".
  // src/index.js ja trata a ausencia do binding: o formulario cai
  // para e-mail em vez de mostrar erro ao visitante.

  "observability": {
    "enabled": true
  }
}
